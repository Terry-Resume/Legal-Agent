# ── Demo mode (canned reviews; no keys) ──
# KATO8_DEMO=1
# VITE_KATO8_DEMO=1
# Ignored automatically when CLERK_SECRET_KEY is set.

# ── Auth (Clerk). Every /api route verifies the session and role; 503 if unset. ──
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ── AI. Server side only. ──
ANTHROPIC_API_KEY=your_api_key_here
# ANTHROPIC_MODEL_PREMIUM=

# ── Suite links (optional overrides; defaults live in @kato8/core) ──
# VITE_KATO8_URL_HUB=https://hub.example.com
